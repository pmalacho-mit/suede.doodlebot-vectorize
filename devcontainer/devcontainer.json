{
  "name": "arcline-vectorize",
  "build": { "dockerfile": "Dockerfile" },
  "features": {
    "ghcr.io/devcontainers/features/rust:1": { "version": "latest", "profile": "default" },
    "ghcr.io/devcontainers/features/python:1": { "version": "3.12", "installTools": true },
    "ghcr.io/devcontainers/features/node:1": { "version": "22" }
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer",
        "tamasfe.even-better-toml",
        "vadimcn.vscode-lldb",
        "ms-python.python",
        "dbaeumer.vscode-eslint"
      ],
      "settings": {
        "rust-analyzer.cargo.features": ["cli", "python"],
        "rust-analyzer.check.command": "clippy"
      }
    }
  },
  "forwardPorts": [8000],
  "portsAttributes": { "8000": { "label": "web demo (python -m http.server)" } },
  "remoteUser": "vscode"
}
