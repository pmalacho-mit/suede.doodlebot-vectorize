{
  "name": "arcline-vectorize",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/python:1": { "version": "3.12" },
    "ghcr.io/devcontainers/features/node:1": { "version": "22" }
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "remoteEnv": { "PATH": "${containerEnv:HOME}/.cargo/bin:${containerEnv:PATH}" },
  "customizations": {
    "vscode": {
      "extensions": ["rust-lang.rust-analyzer", "tamasfe.even-better-toml", "ms-python.python"],
      "settings": {
        "rust-analyzer.linkedProjects": ["release/Cargo.toml"],
        "rust-analyzer.cargo.features": ["cli", "python"]
      }
    }
  },
  "forwardPorts": [8000],
  "portsAttributes": { "8000": { "label": "web demo (python -m http.server)" } }
}